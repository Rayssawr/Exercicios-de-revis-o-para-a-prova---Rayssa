<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Exercício 8 - Galeria de Imagens</title>
    <style>
        .galeria-botoes { margin-bottom: 20px; }
        .area-exibicao { border: 2px dashed #ccc; padding: 20px; width: 450px; text-align: center; }
        #imagem-principal { max-width: 100%; height: 300px; display: none; }
    </style>
</head>
<body>
    <div class="galeria-botoes">
        <button class="btn-img" data-src="https://picsum.photos" data-nome="Praia e Montanhas">Ver Imagem 1</button>
        <button class="btn-img" data-src="https://picsum.photos" data-nome="Livros e Mesa">Ver Imagem 2</button>
        <button class="btn-img" data-src="https://picsum.photos" data-nome="Montanha Nevada">Ver Imagem 3</button>
    </div>

    <div class="area-exibicao">
        <h3 id="nome-imagem">Nenhuma imagem selecionada</h3>
        <img id="imagem-principal" src="" alt="Imagem Ampliada">
    </div>

    <script>
        const botoes = document.querySelectorAll('.btn-img');
        const imgPrincipal = document.getElementById('imagem-principal');
        const nomeImagem = document.getElementById('nome-imagem');

        botoes.forEach(botao => {
            botao.addEventListener('click', () => {
                const src = botao.getAttribute('data-src');
                const nome = botao.getAttribute('data-nome');

                imgPrincipal.src = src;
                imgPrincipal.style.display = "block";
                nomeImagem.textContent = nome;
            });
        });
    </script>
</body>
</html>

