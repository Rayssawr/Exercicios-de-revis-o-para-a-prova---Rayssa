<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Exercício 9 - Controle de Estoque</title>
</head>
<body>
    <h2>Cadastrar Produto</h2>
    <input type="text" id="nome-prod" placeholder="Nome do produto">
    <input type="number" id="qtd-prod" placeholder="Quantidade" min="0">
    <input type="number" id="preco-prod" placeholder="Preço (R$)" step="0.01" min="0">
    <button id="btn-cadastrar-prod">Cadastrar</button>

    <h2>Estoque Atual</h2>
    <table border="1" id="tabela-estoque" style="width: 500px; text-align: left;">
        <thead>
            <tr>
                <th>Produto</th>
                <th>Qtd</th>
                <th>Preço</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>

    <h3>Valor Total do Estoque: R$ <span id="valor-total-estoque">0.00</span></h3>

    <script>
        const inputNome = document.getElementById('nome-prod');
        const inputQtd = document.getElementById('qtd-prod');
        const inputPreco = document.getElementById('preco-prod');
        const btnCadastrar = document.getElementById('btn-cadastrar-prod');
        const tabelaCorpo = document.querySelector('#tabela-estoque tbody');
        const valorTotalTxt = document.getElementById('valor-total-estoque');

        let produtos = [];

        function calcularTotal() {
            const total = produtos.reduce((acc, p) => acc + (p.qtd * p.preco), 0);
            valorTotalTxt.textContent = total.toFixed(2);
        }

        btnCadastrar.addEventListener('click', () => {
            const nome = inputNome.value.trim();
            const qtd = Number(inputQtd.value);
            const preco = Number(inputPreco.value);

            if (!nome || inputQtd.value === "" || inputPreco.value === "") return;

            const produto = { id: Date.now(), nome, qtd, preco };
            produtos.push(produto);

            const tr = document.createElement('tr');
            tr.id = `prod-${produto.id}`;
            tr.innerHTML = `
                <td>${produto.nome}</td>
                <td>${produto.qtd}</td>
                <td>R$ ${produto.preco.toFixed(2)}</td>
            `;

            const tdAcao = document.createElement('td');
            const btnExcluir = document.createElement('button');
            btnExcluir.textContent = "Excluir";
            btnExcluir.addEventListener('click', () => {
                produtos = produtos.filter(p => p.id !== produto.id);
                tr.remove();
                calcularTotal();
            });

            tdAcao.appendChild(btnExcluir);
            tr.appendChild(tdAcao);
            tabelaCorpo.appendChild(tr);

            calcularTotal();
            inputNome.value = "";
            inputQtd.value = "";
            inputPreco.value = "";
        });
    </script>
</body>
</html>

