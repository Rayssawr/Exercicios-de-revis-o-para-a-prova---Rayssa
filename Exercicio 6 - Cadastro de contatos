<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Exercício 6 - Cadastro de Contatos</title>
    <style>
        .contato-item { border-bottom: 1px solid #ddd; padding: 8px; margin-bottom: 5px; }
    </style>
</head>
<body>
    <h2>Novo Contato</h2>
    <input type="text" id="nome" placeholder="Nome"><br><br>
    <input type="text" id="telefone" placeholder="Telefone"><br><br>
    <input type="email" id="email" placeholder="E-mail"><br><br>
    <button id="btn-cadastrar">Cadastrar</button>

    <h2>Lista de Contatos</h2>
    <div id="lista-contatos"></div>

    <script>
        const inputNome = document.getElementById('nome');
        const inputTelefone = document.getElementById('telefone');
        const inputEmail = document.getElementById('email');
        const btnCadastrar = document.getElementById('btn-cadastrar');
        const listaContatos = document.getElementById('lista-contatos');

        btnCadastrar.addEventListener('click', () => {
            const nome = inputNome.value.trim();
            const telefone = inputTelefone.value.trim();
            const email = inputEmail.value.trim();

            if (!nome || !telefone || !email) {
                alert("Todos os campos são obrigatórios!");
                return;
            }

            const divContato = document.createElement('div');
            divContato.className = 'contato-item';

            divContato.innerHTML = `
                <p><strong>Nome:</strong> ${nome} | <strong>Tel:</strong> ${telefone} | <strong>E-mail:</strong> ${email}</p>
            `;

            const btnExcluir = document.createElement('button');
            btnExcluir.textContent = "Excluir Contato";
            btnExcluir.addEventListener('click', () => divContato.remove());

            divContato.appendChild(btnExcluir);
            listaContatos.appendChild(divContato);

            inputNome.value = "";
            inputTelefone.value = "";
            inputEmail.value = "";
        });
    </script>
</body>
</html>

