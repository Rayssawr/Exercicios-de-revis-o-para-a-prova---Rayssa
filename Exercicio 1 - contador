

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Exercício 1 - Contador</title>
</head>
<body>
    <h1>Contador: <span id="contador">0</span></h1>
    <button id="btn-incrementar">Incrementar</button>
    <button id="btn-decrementar">Decrementar</button>
    <button id="btn-zerar">Zerar</button>

    <script>
        const contadorTxt = document.getElementById('contador');
        const btnIncrementar = document.getElementById('btn-incrementar');
        const btnDecrementar = document.getElementById('btn-decrementar');
        const btnZerar = document.getElementById('btn-zerar');

        let valor = 0;

        btnIncrementar.addEventListener('click', () => {
            valor++;
            contadorTxt.textContent = valor;
        });

        btnDecrementar.addEventListener('click', () => {
            valor--;
            contadorTxt.textContent = valor;
        });

        btnZerar.addEventListener('click', () => {
            valor = 0;
            contadorTxt.textContent = valor;
        });
    </script>
</body>
</html>
