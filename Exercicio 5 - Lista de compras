<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <title>Exercício 5 - Lista de Compras</title>
    <style>
        .comprado {
            text-decoration: line-through;
            color: gray;
        }
        li { margin-bottom: 5px; }
        button { margin-left: 5px; }
    </style>
</head>
<body>
    <input type="text" id="produto" placeholder="Nome do produto">
    <button id="btn-add">Adicionar</button>

    <ul id="lista-compras"></ul>

    <script>
        const inputProduto = document.getElementById('produto');
        const btnAdd = document.getElementById('btn-add');
        const listaCompras = document.getElementById('lista-compras');

        btnAdd.addEventListener('click', () => {
            const produtoNome = inputProduto.value.trim();

            if (produtoNome === "") return;

            const li = document.createElement('li');
            
            const spanNome = document.createElement('span');
            spanNome.textContent = produtoNome;

            const btnComprado = document.createElement('button');
            btnComprado.textContent = "Comprado";
            btnComprado.addEventListener('click', () => {
                spanNome.classList.toggle('comprado');
            });

            const btnExcluir = document.createElement('button');
            btnExcluir.textContent = "Excluir";
            btnExcluir.addEventListener('click', () => {
                li.remove();
            });

            li.appendChild(spanNome);
            li.appendChild(btnComprado);
            li.appendChild(btnExcluir);
            listaCompras.appendChild(li);

            inputProduto.value = "";
        });
    </script>
</body>
</html>
